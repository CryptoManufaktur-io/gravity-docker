# Copy to .env, use "nano .env". Don't edit default.env itself.

ENV_VERSION=1
COMPOSE_FILE=gravity.yml:ext-network.yml

# --- Image ---
GRAVITY_IMAGE=ghcr.io/galxe/gravity_node
IMAGE_TAG=v1.9.1
RUST_LOG=info

# --- Chain ---
CHAIN_ID=127001

# --- Ports ---
PUBLIC_PORT=26180


RPC_PORT=8545
METRICS_PORT=9001
INSPECTION_PORT=10001
AUTHRPC_PORT=8661
P2P_PORT_RETH=12024

TXPOOL_MAX_ACCOUNT_SLOTS=64
# >= 10064 required for production PFN pruning. Leave commented to disable
# pruning (archive-style, larger disk) and use reth_config_pfn.json.tpl
# instead of reth_config_pfn_prune.json.tpl in render-config.sh.
PRUNE_TRANSACTIONLOOKUP_DISTANCE=10064

RPC_HTTP_CORSDOMAIN=*
RPC_HTTP_API=debug,eth,net,trace,txpool,web3,rpc

# --- Container-internal paths (fixed by entrypoint.sh, do not change) ---
CONFIG_DIR=/gravity/config
DATA_DIR=/gravity/data
STORAGE_DIR=/gravity/data/data
LOG_DIR=/gravity/logs
GENESIS_PATH=/gravity/config/genesis.json

NETWORK_IDENTITY_TYPE=from_file
NETWORK_IDENTITY_FIELD=path
NETWORK_IDENTITY_VALUE=/gravity/config/identity.yaml
SAFETY_RULES_IDENTITY_VARIANT=from_file
SAFETY_RULES_IDENTITY_KEY=identity_blob_path
SAFETY_RULES_IDENTITY_VALUE=/gravity/config/identity.yaml
DISCOVERY_METHOD_FULLNODE_BLOCK=

# --- Snapshot ---
GRAVITY_SNAPSHOT_DATE=

# --- Traefik / host ---
DOMAIN=cryptomanufaktur.net
RPC_HOST=gravity
RPC_LB=gravity

# IP of the host you want to use in Docker (in case host has several IPs)
HOST_IP=
# IP to host-map a port through *-shared.yml. Set to 127.0.0.1 to restrict to localhost
SHARE_IP=

# External Docker network — must match the network traefik itself is on
DOCKER_EXT_NETWORK=traefik_default
